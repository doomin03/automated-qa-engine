                "type": "null"
              }
            ]
          },
          "sourceMap": {
            "anyOf": [
              {
                "$ref": "#/definitions/sourceMap"
              },
              {
                "type": "null"
              }
            ]
          },
          "diagnostics": {
            "type": "array",
            "maxItems": 0
          }
        },
        "required": [
          "schemaVersion",
          "authoringContractVersion",
          "blueprint",
          "xml",
          "blueprintSnapshotHash",
          "flowSnapshotHash",
          "template",
          "sourceMap",
          "diagnostics"
        ]
      },
      "failure": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
