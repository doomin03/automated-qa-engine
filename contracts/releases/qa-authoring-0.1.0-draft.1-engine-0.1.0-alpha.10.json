          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bindings": {
            "type": "object"
          }
        },
        "required": [
          "templateId",
          "version",
          "sha256",
          "bindings"
        ]
      },
      "templatePin": {
        "type": "object",
        "additionalProperties": false,
