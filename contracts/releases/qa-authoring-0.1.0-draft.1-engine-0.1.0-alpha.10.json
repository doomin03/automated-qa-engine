  "schemaSha256": "8f156fb6efcb97b9ab890b78ed38c5a0beb2830bd1389fab80a10b4e6c96d226",
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "urn:automated-qa:document-authoring:v1",
    "definitions": {
      "composition": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "const": "qa.composition/v1"
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "not": {
                    "enum": [
                      "__proto__",
                      "constructor",
                      "prototype"
                    ]
                  }
                },
                "format": {
                  "enum": [
                    "xml",
                    "json"
                  ]
                },
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1048576
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "id",
                "format",
                "source",
                "sha256"
              ]
            },
            "minItems": 1,
            "maxItems": 64
          },
          "instances": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "not": {
                    "enum": [
                      "__proto__",
                      "constructor",
                      "prototype"
                    ]
                  }
                },
                "assetId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "not": {
                    "enum": [
                      "__proto__",
                      "constructor",
                      "prototype"
                    ]
                  }
                }
              },
              "required": [
                "id",
                "assetId"
              ]
            },
            "minItems": 1,
            "maxItems": 64
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "from": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "not": {
                    "enum": [
                      "__proto__",
                      "constructor",
                      "prototype"
                    ]
                  }
                },
                "to": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "not": {
                    "enum": [
                      "__proto__",
                      "constructor",
                      "prototype"
                    ]
