          "blueprintSnapshotHash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "flowSnapshotHash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "template": {
            "anyOf": [
              {
                "$ref": "#/definitions/templatePin"
              },
