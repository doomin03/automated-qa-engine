          "syntheticNodes": {
            "const": [
              "composition_start",
              "composition_end"
            ]
          }
        },
        "required": [
          "schemaVersion",
          "blueprintSnapshotHash",
          "flowSnapshotHash",
          "nodes",
          "syntheticNodes"
        ]
      },
