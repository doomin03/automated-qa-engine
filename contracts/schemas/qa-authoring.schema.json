{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:automated-qa:document-authoring:v1",
  "definitions": {
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "qa.composition/v1"
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "not": {
                  "enum": [
                    "__proto__",
                    "constructor",
                    "prototype"
                  ]
                }
              },
              "format": {
                "enum": [
                  "xml",
                  "json"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1048576
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "format",
              "source",
              "sha256"
            ]
          },
          "minItems": 1,
          "maxItems": 64
        },
        "instances": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "not": {
                  "enum": [
                    "__proto__",
                    "constructor",
                    "prototype"
                  ]
                }
              },
              "assetId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "not": {
                  "enum": [
                    "__proto__",
                    "constructor",
                    "prototype"
                  ]
                }
              }
            },
            "required": [
              "id",
              "assetId"
            ]
          },
          "minItems": 1,
          "maxItems": 64
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "not": {
                  "enum": [
                    "__proto__",
                    "constructor",
                    "prototype"
                  ]
                }
              },
              "to": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "not": {
                  "enum": [
                    "__proto__",
                    "constructor",
                    "prototype"
                  ]
                }
              }
            },
            "required": [
              "from",
              "to"
            ]
          },
          "minItems": 0,
          "maxItems": 63
        }
      },
      "required": [
        "schemaVersion",
        "assets",
        "instances",
        "links"
      ]
    },
    "templateRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "templateId": {
          "enum": [
            "empty",
            "web-open-click",
            "web-input-check",
            "native-open-check"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bindings": {
          "type": "object"
        }
      },
      "required": [
        "templateId",
        "version",
        "sha256",
        "bindings"
      ]
    },
    "templatePin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "empty",
            "web-open-click",
            "web-input-check",
            "native-open-check"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ]
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "empty",
            "web-open-click",
            "web-input-check",
            "native-open-check"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "description": {
          "type": "string"
        },
        "supportedPlatforms": {
          "type": "array",
          "items": {
            "enum": [
              "web",
              "android",
              "ios"
            ]
          },
          "minItems": 1,
          "maxItems": 3
        },
        "requiredActions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "maxItems": 16
        },
        "inputSchema": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "version",
        "sha256",
        "description",
        "supportedPlatforms",
        "requiredActions",
        "inputSchema"
      ]
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authoringContractVersion": {
          "const": "0.1.0-draft.1"
        },
        "templates": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/template"
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": [
        "authoringContractVersion",
        "templates"
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "path": {
          "type": "string",
          "maxLength": 4096
        },
        "message": {
          "type": "string",
          "maxLength": 256
        },
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "enum": [
              "__proto__",
              "constructor",
              "prototype"
            ]
          }
        },
        "instanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "enum": [
              "__proto__",
              "constructor",
              "prototype"
            ]
          }
        },
        "sourceNodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "enum": [
              "__proto__",
              "constructor",
              "prototype"
            ]
          }
        }
      },
      "required": [
        "code",
        "path",
        "message"
      ]
    },
    "sourceMap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "qa.compositionSourceMap/v1"
        },
        "blueprintSnapshotHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "flowSnapshotHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "nodes": {
          "type": "object",
          "maxProperties": 998,
          "propertyNames": {
            "pattern": "^b_[a-f0-9]{24}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "instanceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "not": {
                  "enum": [
                    "__proto__",
                    "constructor",
                    "prototype"
                  ]
                }
              },
              "assetId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "not": {
                  "enum": [
                    "__proto__",
                    "constructor",
                    "prototype"
                  ]
                }
              },
              "sourceNodeId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "sourceHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "instanceId",
              "assetId",
              "sourceNodeId",
              "sourceHash"
            ]
          }
        },
        "syntheticNodes": {
          "const": [
            "composition_start",
            "composition_end"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "blueprintSnapshotHash",
        "flowSnapshotHash",
        "nodes",
        "syntheticNodes"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "qa.authoredBlueprint/v1"
        },
        "authoringContractVersion": {
          "const": "0.1.0-draft.1"
        },
        "blueprint": {
          "$ref": "urn:automated-qa:contracts:v1#/definitions/blueprint"
        },
        "xml": {
          "type": "string",
          "maxLength": 1048576
        },
        "blueprintSnapshotHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "flowSnapshotHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "template": {
          "anyOf": [
            {
              "$ref": "#/definitions/templatePin"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceMap": {
          "anyOf": [
            {
              "$ref": "#/definitions/sourceMap"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 0
        }
      },
      "required": [
        "schemaVersion",
        "authoringContractVersion",
        "blueprint",
        "xml",
        "blueprintSnapshotHash",
        "flowSnapshotHash",
        "template",
        "sourceMap",
        "diagnostics"
      ]
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "message": {
              "type": "string",
              "maxLength": 256
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "diagnostics": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/diagnostic"
                  },
                  "minItems": 1,
                  "maxItems": 64
                }
              },
              "required": [
                "diagnostics"
              ]
            }
          },
          "required": [
            "code",
            "message",
            "details"
          ]
        }
      },
      "required": [
        "error"
      ]
    }
  }
}
