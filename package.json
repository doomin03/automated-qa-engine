{
  "name": "automated-qa-engine",
  "version": "0.1.0-alpha.2",
  "private": true,
  "type": "module",
  "types": "./packages/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./packages/core/index.d.ts",
      "import": "./packages/core/index.mjs"
    },
    "./playwright": {
      "types": "./runners/playwright/adapter.d.ts",
      "import": "./runners/playwright/adapter.mjs"
    }
  },
  "description": "Declarative QA CLI, browser runner and AI-authored Blueprint contracts",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "doctor": "node packages/cli/aqa.mjs doctor",
    "check:foundation": "node scripts/check-foundation.mjs",
    "spec:validate": "openspec validate --all --strict --no-interactive",
    "verify": "npm run check:foundation && npm run spec:validate && node scripts/build-contract.mjs --check && node scripts/build-types.mjs --check && npm test",
    "aqa": "node packages/cli/aqa.mjs",
    "demo": "node packages/cli/aqa.mjs demo",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "contracts:bundle": "node scripts/build-contract.mjs",
    "types:build": "node scripts/build-types.mjs",
    "test:package": "node scripts/test-package.mjs"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.14.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "fast-xml-parser": "5.11.2",
    "playwright": "1.64.1",
    "yaml": "2.9.1"
  },
  "bin": {
    "aqa": "packages/cli/aqa.mjs"
  },
  "files": [
    "packages/core",
    "packages/cli",
    "runners",
    "contracts",
    "examples",
    "README.md",
    "docs/package-api.md",
    "docs/xml-format.md",
    "docs/ai-authoring.md"
  ]
}
